# Reusable manual rules for the Fedora worker node.
#
# Cilium/Kubernetes-generated chains are intentionally omitted.
#
# Current Cilium networking:
#   routing-mode: tunnel
#   tunnel-protocol: vxlan
#   ipv4-native-routing-cidr: 10.32.0.0/12
#
# WireGuard provides connectivity between Fedora and the OCI nodes.

# Cilium VXLAN
-A INPUT -p udp --dport 8472 -j ACCEPT

# Forward traffic between WireGuard and the home LAN.
-A FORWARD -i wg0 -o enp2s0 -j ACCEPT
-A FORWARD -i enp2s0 -o wg0 -j ACCEPT

# TCP MSS clamping for traffic crossing the WireGuard path.
-A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
